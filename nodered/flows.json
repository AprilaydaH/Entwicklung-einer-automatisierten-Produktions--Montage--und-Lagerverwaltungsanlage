    {
        "id": "fn_format",
        "type": "function",
        "z": "tab_flow",
        "name": "format",
        "func": "const STATE = {\n  0: '0 Ready', 10: '10 RFID wait', 20: '20 Free slot', 30: '30 To band',\n  40: '40 Fork band', 41: '41 Lift + pick', 42: '42 Retract', 50: '50 To slot',\n  55: '55 Fork rack', 56: '56 Place', 58: '58 Retract', 60: '60 DB',\n  70: '70 Home', 80: '80 Done', 900: '900 Fault'\n};\nfunction occBytes(p, k) {\n  const b = [];\n  for (let i = 0; i < 7; i++) b.push(Number(p[k + i]) || 0);\n  return b;\n}\nfunction occArr(p, k) {\n  const bytes = occBytes(p, k);\n  const a = new Array(55).fill(false);\n  for (let n = 1; n <= 54; n++) {\n    const bi = Math.floor((n - 1) / 8);\n    const bit = (n - 1) % 8;\n    a[n] = !!((bytes[bi] || 0) & (1 << bit));\n  }\n  return a;\n}\nfunction r3(v) {\n  const n = Number(v);\n  return Number.isFinite(n) ? n.toFixed(3) : '—';\n}\nconst p = (msg.payload && typeof msg.payload === 'object') ? msg.payload : {};\np.StateText = STATE[p.HMI_State_W2] || String(p.HMI_State_W2 == null ? '—' : p.HMI_State_W2);\np.StateTextW1 = STATE[p.HMI_State] || String(p.HMI_State == null ? '—' : p.HMI_State);\np.IstXZ = r3(p.Ist_X_W2) + ' / ' + r3(p.Ist_Z_W2);\np.SollXZ = r3(p.Soll_X_W2) + ' / ' + r3(p.Soll_Z_W2);\np.occW1 = occArr(p, 'HRL_Occ_');\np.occW2 = occArr(p, 'HRL2_Occ_');\np.zielW1 = Number(p.HMI_Ziel_Fach) || 0;\np.zielW2 = Number(p.HMI_Ziel_Fach_W2) || 0;\nmsg.payload = p;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "x": 330,
        "y": 80,
        "wires": [
            [
                "ui_rack_w1",
                "ui_status_w1",
                "chg_state_w1",
                "chg_belegt_w1",
                "chg_frei_w1",
                "ui_rack_w2",
                "ui_status",
                "chg_state",
                "chg_ziel",
                "chg_belegt",
                "chg_frei",
                "chg_rfid",
                "chg_art",
                "chg_vis",
                "chg_ist",
                "chg_soll",
                "chg_act",
                "chg_metal"
            ]
        ]
    },
