        "z": "tab_flow",
        "group": "ui_grp_rack_w1",
        "name": "rack W1",
        "order": 1,
        "width": "6",
        "height": "9",
        "format": "<style>\n.hrack{border-collapse:collapse;font-family:Segoe UI,sans-serif}\n.hrack td{width:38px;height:26px;text-align:center;font-size:11px;border:1px solid #9aa;background:#E6E6E6;color:#222}\n.hrack.w1 td.belegt{background:#4A90D9;color:#fff}\n.hrack.w2 td.belegt{background:#5B7C99;color:#fff}\n.hrack td.ziel{outline:3px solid #F1C40F;outline-offset:-3px;font-weight:700}\n.hrack-cap{margin-top:6px;font:13px Segoe UI,sans-serif}\n.hrack-leg{font-size:11px;color:#555;margin-top:4px}\n.hrack-note{font-size:11px;color:#888;margin-bottom:6px}\n</style>\n<div class=\"hrack-note\">Numbers always show. Yellow outline = Ziel-Fach. Click Demo if PLC is offline.</div><table class=\"hrack w1\"><tr><td ng-class=\"{belegt: msg.payload.occW1[49], ziel: msg.payload.zielW1==49}\">49</td><td ng-class=\"{belegt: msg.payload.occW1[50], ziel: msg.payload.zielW1==50}\">50</td><td ng-class=\"{belegt: msg.payload.occW1[51], ziel: msg.payload.zielW1==51}\">51</td><td ng-class=\"{belegt: msg.payload.occW1[52], ziel: msg.payload.zielW1==52}\">52</td><td ng-class=\"{belegt: msg.payload.occW1[53], ziel: msg.payload.zielW1==53}\">53</td><td ng-class=\"{belegt: msg.payload.occW1[54], ziel: msg.payload.zielW1==54}\">54</td></tr><tr><td ng-class=\"{belegt: msg.payload.occW1[43], ziel: msg.payload.zielW1==43}\">43</td><td ng-class=\"{belegt: msg.payload.occW1[44], ziel: msg.payload.zielW1==44}\">44</td><td ng-class=\"{belegt: msg.payload.occW1[45], ziel: msg.payload.zielW1==45}\">45</td><td ng-class=\"{belegt: msg.payload.occW1[46], ziel: msg.payload.zielW1==46}\">46</td><td ng-class=\"{belegt: msg.payload.occW1[47], ziel: msg.payload.zielW1==47}\">47</td><td ng-class=\"{belegt: msg.payload.occW1[48], ziel: msg.payload.zielW1==48}\">48</td></tr><tr><td ng-class=\"{belegt: msg.payload.occW1[37], ziel: msg.payload.zielW1==37}\">37</td><td ng-class=\"{belegt: msg.payload.occW1[38], ziel: msg.payload.zielW1==38}\">38</td><td ng-class=\"{belegt: msg.payload.occW1[39], ziel: msg.payload.zielW1==39}\">39</td><td ng-class=\"{belegt: msg.payload.occW1[40], ziel: msg.payload.zielW1==40}\">40</td><td ng-class=\"{belegt: msg.payload.occW1[41], ziel: msg.payload.zielW1==41}\">41</td><td ng-class=\"{belegt: msg.payload.occW1[42], ziel: msg.payload.zielW1==42}\">42</td></tr><tr><td ng-class=\"{belegt: msg.payload.occW1[31], ziel: msg.payload.zielW1==31}\">31</td><td ng-class=\"{belegt: msg.payload.occW1[32], ziel: msg.payload.zielW1==32}\">32</td><td ng-class=\"{belegt: msg.payload.occW1[33], ziel: msg.payload.zielW1==33}\">33</td><td ng-class=\"{belegt: msg.payload.occW1[34], ziel: msg.payload.zielW1==34}\">34</td><td ng-class=\"{belegt: msg.payload.occW1[35], ziel: msg.payload.zielW1==35}\">35</td><td ng-class=\"{belegt: msg.payload.occW1[36], ziel: msg.payload.zielW1==36}\">36</td></tr><tr><td ng-class=\"{belegt: msg.payload.occW1[25], ziel: msg.payload.zielW1==25}\">25</td><td ng-class=\"{belegt: msg.payload.occW1[26], ziel: msg.payload.zielW1==26}\">26</td><td ng-class=\"{belegt: msg.payload.occW1[27], ziel: msg.payload.zielW1==27}\">27</td><td ng-class=\"{belegt: msg.payload.occW1[28], ziel: msg.payload.zielW1==28}\">28</td><td ng-class=\"{belegt: msg.payload.occW1[29], ziel: msg.payload.zielW1==29}\">29</td><td ng-class=\"{belegt: msg.payload.occW1[30], ziel: msg.payload.zielW1==30}\">30</td></tr><tr><td ng-class=\"{belegt: msg.payload.occW1[19], ziel: msg.payload.zielW1==19}\">19</td><td ng-class=\"{belegt: msg.payload.occW1[20], ziel: msg.payload.zielW1==20}\">20</td><td ng-class=\"{belegt: msg.payload.occW1[21], ziel: msg.payload.zielW1==21}\">21</td><td ng-class=\"{belegt: msg.payload.occW1[22], ziel: msg.payload.zielW1==22}\">22</td><td ng-class=\"{belegt: msg.payload.occW1[23], ziel: msg.payload.zielW1==23}\">23</td><td ng-class=\"{belegt: msg.payload.occW1[24], ziel: msg.payload.zielW1==24}\">24</td></tr><tr><td ng-class=\"{belegt: msg.payload.occW1[13], ziel: msg.payload.zielW1==13}\">13</td><td ng-class=\"{belegt: msg.payload.occW1[14], ziel: msg.payload.zielW1==14}\">14</td><td ng-class=\"{belegt: msg.payload.occW1[15], ziel: msg.payload.zielW1==15}\">15</td><td ng-class=\"{belegt: msg.payload.occW1[16], ziel: msg.payload.zielW1==16}\">16</td><td ng-class=\"{belegt: msg.payload.occW1[17], ziel: msg.payload.zielW1==17}\">17</td><td ng-class=\"{belegt: msg.payload.occW1[18], ziel: msg.payload.zielW1==18}\">18</td></tr><tr><td ng-class=\"{belegt: msg.payload.occW1[7], ziel: msg.payload.zielW1==7}\">7</td><td ng-class=\"{belegt: msg.payload.occW1[8], ziel: msg.payload.zielW1==8}\">8</td><td ng-class=\"{belegt: msg.payload.occW1[9], ziel: msg.payload.zielW1==9}\">9</td><td ng-class=\"{belegt: msg.payload.occW1[10], ziel: msg.payload.zielW1==10}\">10</td><td ng-class=\"{belegt: msg.payload.occW1[11], ziel: msg.payload.zielW1==11}\">11</td><td ng-class=\"{belegt: msg.payload.occW1[12], ziel: msg.payload.zielW1==12}\">12</td></tr><tr><td ng-class=\"{belegt: msg.payload.occW1[1], ziel: msg.payload.zielW1==1}\">1</td><td ng-class=\"{belegt: msg.payload.occW1[2], ziel: msg.payload.zielW1==2}\">2</td><td ng-class=\"{belegt: msg.payload.occW1[3], ziel: msg.payload.zielW1==3}\">3</td><td ng-class=\"{belegt: msg.payload.occW1[4], ziel: msg.payload.zielW1==4}\">4</td><td ng-class=\"{belegt: msg.payload.occW1[5], ziel: msg.payload.zielW1==5}\">5</td><td ng-class=\"{belegt: msg.payload.occW1[6], ziel: msg.payload.zielW1==6}\">6</td></tr></table><div class=\"hrack-cap\">Ziel-Fach <b>{{msg.payload.zielW1 || 0}}</b> · Belegt {{msg.payload.HRL_Anzahl_Belegt || 0}} · Frei {{msg.payload.HRL_Anzahl_Frei != null ? msg.payload.HRL_Anzahl_Frei : 54}}</div><div class=\"hrack-leg\">Kunststoff 5B · Level 8 oben · Fach 1–6 unten</div>",
