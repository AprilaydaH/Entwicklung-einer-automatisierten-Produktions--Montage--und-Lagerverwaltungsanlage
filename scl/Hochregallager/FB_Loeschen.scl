// ============================================================================
// Bausteinname : FB_Loeschen
// Version      : V1.2
// INTERFACE:
//   IN  Execute : Bool
//   OUT Done, Error : Bool; Info_Code : UInt
//   TEMP iFach : Int
// ============================================================================

#Done := FALSE;
#Error := FALSE;
#Info_Code := UINT#0;

IF NOT #Execute THEN
    RETURN;
END_IF;

"gldb_AktuellerFach_HMI".Meldung.Funktion_Meldung_Ok := FALSE;
"gldb_AktuellerFach_HMI".Meldung.Info_Code := UINT#0;

#iFach := UINT_TO_INT("gldb_AktuellerFach_HMI".Auswahl.Ausgewaeltes_Fach);

IF (#iFach < 1) OR (#iFach > 54) THEN
    #iFach := USINT_TO_INT("gldb_AktuellerFach_HMI".Auswahl.Fachaktuell.Fachnummer);
END_IF;

IF (#iFach < 1) OR (#iFach > 54) THEN
    #Error := TRUE;
    #Info_Code := UINT#3;
    "gldb_AktuellerFach_HMI".Meldung.Info_Code := UINT#3;
    RETURN;
END_IF;

IF "gldb_LagerverwaltungData".Fach[#iFach].Gesperrt THEN
    #Error := TRUE;
    #Info_Code := UINT#15;
    "gldb_AktuellerFach_HMI".Meldung.Info_Code := UINT#15;
    RETURN;
END_IF;

"gldb_LagerverwaltungData".Fach[#iFach].Fachnummer := INT_TO_USINT(#iFach);
"gldb_LagerverwaltungData".Fach[#iFach].Artikelnummer := UINT#0;
"gldb_LagerverwaltungData".Fach[#iFach].Materialart := USINT#0;
"gldb_LagerverwaltungData".Fach[#iFach].ProductTyp := UINT#0;
"gldb_LagerverwaltungData".Fach[#iFach].Kennzeichnung := '';
"gldb_LagerverwaltungData".Fach[#iFach]."Datum eingelagert" := '';
"gldb_LagerverwaltungData".Fach[#iFach].RFID_CODE := UDINT#0;
"gldb_LagerverwaltungData".Fach[#iFach].Inf_Text := '';
"gldb_LagerverwaltungData".Fach[#iFach].Datum_Ziffer := DTL#1970-01-01-00:00:00;
"gldb_LagerverwaltungData".Fach[#iFach].Belegt := FALSE;

"gldb_AktuellerFach_HMI".Auswahl.Fachaktuell.Fachnummer := INT_TO_USINT(#iFach);
"gldb_AktuellerFach_HMI".Auswahl.Fachaktuell.Belegt := FALSE;
"gldb_AktuellerFach_HMI".Auswahl.Fachaktuell.Artikelnummer := UINT#0;
"gldb_AktuellerFach_HMI".Auswahl.Fachaktuell.RFID_CODE := UDINT#0;

#Done := TRUE;
#Info_Code := UINT#6;
"gldb_AktuellerFach_HMI".Meldung.Info_Code := UINT#6;
"gldb_AktuellerFach_HMI".Meldung.Funktion_Meldung_Ok := TRUE;
