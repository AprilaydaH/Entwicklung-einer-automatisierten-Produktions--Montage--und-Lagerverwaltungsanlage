// Warehouse_2 Metal mirror — separate DBs/tags from Warehouse_1
//============================================================================
// Author: Dereje Hailemariam
// Datum: 20.08.2026
// Version: 1.0
// Beschreibung: Fach-Offset wie Fanuc BERECHN_OFFSET
//
// Teach once:
//   Basis_X / Basis_Z  = position of Fach 1 (pallet rest pose)
//   Pitch_X / Pitch_Z  = distance to next column / next level
//
// For any Fachnummer 1..Max_Fach:
//   Mult_X = (Fach - 1) MOD Spalten
//   Mult_Z = (Fach - 1) DIV Spalten
//   Pos_X  = Basis_X + Pitch_X * Mult_X
//   Pos_Z  = Basis_Z + Pitch_Z * Mult_Z
//
// Default grid: Spalten=6 × Reihen=9 → 54 Fächer
// (adjust Spalten to match your Factory I/O numbering)
//============================================================================

FUNCTION_BLOCK "FB_Berechn_Offset_W2"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.0

VAR_INPUT
    Fachnummer                  : Int := 0;
    Basis_X                     : Real := 0.0;
    Basis_Z                     : Real := 0.0;
    Pitch_X                     : Real := 0.0;   // Offset X (one column)
    Pitch_Z                     : Real := 0.0;   // Offset Z (one row / level)
    Spalten                     : Int := 6;      // columns along X
    Max_Fach                    : Int := 54;
END_VAR

VAR_OUTPUT
    Position_X                  : Real;
    Position_Z                  : Real;
    Mult_X                      : Int;           // 0 .. Spalten-1
    Mult_Z                      : Int;           // 0 .. Reihen-1
    Gueltig                     : Bool;
END_VAR

BEGIN
    #Gueltig := FALSE;
    #Position_X := 0.0;
    #Position_Z := 0.0;
    #Mult_X := 0;
    #Mult_Z := 0;

    IF (#Fachnummer >= 1)
       AND (#Fachnummer <= #Max_Fach)
       AND (#Spalten >= 1) THEN

        // Same as Fanuc: ((R[10]-1) MOD 4) / DIV 4
        #Mult_X := (#Fachnummer - 1) MOD #Spalten;
        #Mult_Z := (#Fachnummer - 1) / #Spalten;

        #Position_X := #Basis_X + #Pitch_X * INT_TO_REAL(#Mult_X);
        #Position_Z := #Basis_Z + #Pitch_Z * INT_TO_REAL(#Mult_Z);
        #Gueltig := TRUE;
    END_IF;
END_FUNCTION_BLOCK
