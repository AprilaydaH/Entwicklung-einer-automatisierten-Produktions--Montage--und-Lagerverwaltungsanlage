// Warehouse_2 Metal mirror — separate DBs/tags from Warehouse_1
// ============================================================================
// Bausteinname : FB_Auslagern
// Version      : V1.3
// INTERFACE:
//   IN  Execute : Bool
//   OUT Done, Error : Bool; Info_Code : UInt; Fachnummer : USInt
//   TEMP iFach : Int
// ============================================================================

#Done := FALSE;
#Error := FALSE;
#Info_Code := UINT#0;
#Fachnummer := USINT#0;

IF NOT #Execute THEN
    RETURN;
END_IF;

"gldb_AktuellerFach_HMI_W2".Meldung.Funktion_Meldung_Ok := FALSE;
"gldb_AktuellerFach_HMI_W2".Meldung.Info_Code := UINT#0;

#iFach := USINT_TO_INT("gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell.Fachnummer);

IF (#iFach < 1) OR (#iFach > 54) THEN
    #iFach := UINT_TO_INT("gldb_AktuellerFach_HMI_W2".Auswahl.Ausgewaeltes_Fach);
END_IF;

IF (#iFach < 1) OR (#iFach > 54) THEN
    #Error := TRUE;
    #Info_Code := UINT#3;
    "gldb_AktuellerFach_HMI_W2".Meldung.Info_Code := UINT#3;
    RETURN;
END_IF;

IF "gldb_LagerverwaltungData_W2".Fach[#iFach].Gesperrt THEN
    #Error := TRUE;
    #Info_Code := UINT#15;
    "gldb_AktuellerFach_HMI_W2".Meldung.Info_Code := UINT#15;
    RETURN;
END_IF;

IF NOT "gldb_LagerverwaltungData_W2".Fach[#iFach].Belegt THEN
    #Error := TRUE;
    #Info_Code := UINT#5;
    "gldb_AktuellerFach_HMI_W2".Meldung.Info_Code := UINT#5;
    RETURN;
END_IF;

"gldb_LagerverwaltungData_W2".Fach[#iFach].Fachnummer := INT_TO_USINT(#iFach);
"gldb_LagerverwaltungData_W2".Fach[#iFach].Artikelnummer := UINT#0;
"gldb_LagerverwaltungData_W2".Fach[#iFach].Materialart := USINT#0;
"gldb_LagerverwaltungData_W2".Fach[#iFach].Color_Code := USINT#0;
"gldb_LagerverwaltungData_W2".Fach[#iFach].ProductTyp := UINT#0;
"gldb_LagerverwaltungData_W2".Fach[#iFach].Kennzeichnung := '';
"gldb_LagerverwaltungData_W2".Fach[#iFach]."Datum eingelagert" := '';
"gldb_LagerverwaltungData_W2".Fach[#iFach].RFID_CODE := UDINT#0;
"gldb_LagerverwaltungData_W2".Fach[#iFach].Inf_Text := '';
"gldb_LagerverwaltungData_W2".Fach[#iFach].Datum_Ziffer := DTL#1970-01-01-00:00:00;
"gldb_LagerverwaltungData_W2".Fach[#iFach].Belegt := FALSE;

"gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell.Fachnummer := INT_TO_USINT(#iFach);
"gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell.Belegt := FALSE;
"gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell.Artikelnummer := UINT#0;
"gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell.Color_Code := USINT#0;
"gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell.RFID_CODE := UDINT#0;

#Fachnummer := INT_TO_USINT(#iFach);
#Done := TRUE;
#Info_Code := UINT#4;
"gldb_AktuellerFach_HMI_W2".Meldung.Info_Code := UINT#4;
"gldb_AktuellerFach_HMI_W2".Meldung.Funktion_Meldung_Ok := TRUE;
