// Warehouse_2 Metal mirror — separate DBs/tags from Warehouse_1
//============================================================================
// Bausteinname : FB_Suchen_W2
// Version      : V1.6
//
// INPUT Execute : Bool  (HMI_Suchen_W2, rising edge)
// STAT: R_Go : R_TRIG
// TEMP: Gefunden, Such_RFID, Such_Artikel, Such_Fach, iLaufvar,
//       sFachnummer, sArtikelnummer, sRFID
//
// Priority: RFID_CODE > Artikelnummer > Fachnummer
// RFID / Artikel: only occupied slots (Belegt)
// Fachnummer 1..54: show that slot (empty is OK)
//============================================================================

#R_Go(CLK := #Execute);
IF NOT #R_Go.Q THEN
    RETURN;
END_IF;

#Gefunden := FALSE;
"gldb_AktuellerFach_HMI_W2".Meldung.Funktion_Meldung_Ok := FALSE;
"gldb_AktuellerFach_HMI_W2".Meldung.Info_Code := UINT#0;

#Such_RFID := "gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell.RFID_CODE;
#Such_Artikel := "gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell.Artikelnummer;
#Such_Fach := "gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell.Fachnummer;

IF #Such_RFID <> UDINT#0 THEN
    FOR #iLaufvar := 1 TO 54 DO
        IF "gldb_LagerverwaltungData_W2".Fach[#iLaufvar].Belegt
            AND ("gldb_LagerverwaltungData_W2".Fach[#iLaufvar].RFID_CODE = #Such_RFID) THEN
            #Gefunden := TRUE;
            EXIT;
        END_IF;
    END_FOR;

ELSIF #Such_Artikel <> UINT#0 THEN
    FOR #iLaufvar := 1 TO 54 DO
        IF "gldb_LagerverwaltungData_W2".Fach[#iLaufvar].Belegt
            AND ("gldb_LagerverwaltungData_W2".Fach[#iLaufvar].Artikelnummer = #Such_Artikel) THEN
            #Gefunden := TRUE;
            EXIT;
        END_IF;
    END_FOR;

ELSIF (#Such_Fach >= USINT#1) AND (#Such_Fach <= USINT#54) THEN
    #iLaufvar := USINT_TO_INT(#Such_Fach);
    #Gefunden := TRUE;
END_IF;

IF #Gefunden THEN
    "gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell.Fachnummer :=
        "gldb_LagerverwaltungData_W2".Fach[#iLaufvar].Fachnummer;
    "gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell.Materialart :=
        "gldb_LagerverwaltungData_W2".Fach[#iLaufvar].Materialart;
    "gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell.Color_Code :=
        "gldb_LagerverwaltungData_W2".Fach[#iLaufvar].Color_Code;
    "gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell.Artikelnummer :=
        "gldb_LagerverwaltungData_W2".Fach[#iLaufvar].Artikelnummer;
    "gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell.ProductTyp :=
        "gldb_LagerverwaltungData_W2".Fach[#iLaufvar].ProductTyp;
    "gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell.Kennzeichnung :=
        "gldb_LagerverwaltungData_W2".Fach[#iLaufvar].Kennzeichnung;
    "gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell."Datum eingelagert" :=
        "gldb_LagerverwaltungData_W2".Fach[#iLaufvar]."Datum eingelagert";
    "gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell.Datum_Ziffer :=
        "gldb_LagerverwaltungData_W2".Fach[#iLaufvar].Datum_Ziffer;
    "gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell.RFID_CODE :=
        "gldb_LagerverwaltungData_W2".Fach[#iLaufvar].RFID_CODE;
    "gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell.Belegt :=
        "gldb_LagerverwaltungData_W2".Fach[#iLaufvar].Belegt;
    "gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell.Gesperrt :=
        "gldb_LagerverwaltungData_W2".Fach[#iLaufvar].Gesperrt;
    "gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell.Position_X :=
        "gldb_LagerverwaltungData_W2".Fach[#iLaufvar].Position_X;
    "gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell.Position_Z :=
        "gldb_LagerverwaltungData_W2".Fach[#iLaufvar].Position_Z;
    "gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell.RegalSeite :=
        "gldb_LagerverwaltungData_W2".Fach[#iLaufvar].RegalSeite;
    "gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell.Inf_Text :=
        "gldb_LagerverwaltungData_W2".Fach[#iLaufvar].Inf_Text;

    "gldb_AktuellerFach_HMI_W2".Auswahl.Ausgewaeltes_Fach := INT_TO_UINT(#iLaufvar);
    "HMI_Fachnummer_W2" := INT_TO_UINT(#iLaufvar);
    "gldb_AktuellerFach_HMI_W2".Lagerstatus.Anzeige_noch_Frei :=
        NOT "gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell.Belegt;

    "gldb_AktuellerFach_HMI_W2".Meldung.Info_Code := UINT#9;
    "gldb_AktuellerFach_HMI_W2".Meldung.Funktion_Meldung_Ok := TRUE;

    #sFachnummer := USINT_TO_STRING(
        "gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell.Fachnummer);
    #sArtikelnummer := UINT_TO_STRING(
        "gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell.Artikelnummer);
    #sRFID := UDINT_TO_STRING(
        "gldb_AktuellerFach_HMI_W2".Auswahl.Fachaktuell.RFID_CODE);

    "gldb_AktuellerFach_HMI_W2".Meldung.Info_Text := CONCAT(
        IN1 := CONCAT(IN1 := 'Gefunden | Fach: ', IN2 := #sFachnummer),
        IN2 := CONCAT(
            IN1 := CONCAT(IN1 := ' | Artikel: ', IN2 := #sArtikelnummer),
            IN2 := CONCAT(IN1 := ' | RFID: ', IN2 := #sRFID)
        )
    );
ELSE
    "gldb_AktuellerFach_HMI_W2".Lagerstatus.Anzeige_noch_Frei := TRUE;
    "gldb_AktuellerFach_HMI_W2".Meldung.Info_Code := UINT#8;
    "gldb_AktuellerFach_HMI_W2".Meldung.Info_Text := 'Kein passendes Fach gefunden';
    "gldb_AktuellerFach_HMI_W2".Meldung.Funktion_Meldung_Ok := FALSE;
END_IF;
