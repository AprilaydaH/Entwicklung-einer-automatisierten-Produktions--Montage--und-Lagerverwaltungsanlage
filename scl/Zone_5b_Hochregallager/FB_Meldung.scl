// ============================================================================
// Bausteinname : FB_Meldung
// Version      : V1.5
// Keine lokalen Variablen — nur globale DBs
// ============================================================================

CASE "gldb_AktuellerFach_HMI".Meldung.Info_Code OF

    UINT#0:
        "gldb_AktuellerFach_HMI".Meldung.Info_Text := 'Keine Meldung';
        "gldb_AktuellerFach_HMI".Meldung.Funktion_Meldung_Ok := FALSE;

    UINT#1:
        "gldb_AktuellerFach_HMI".Meldung.Info_Text := 'Einlagerung erfolgreich';
        "gldb_AktuellerFach_HMI".Meldung.Funktion_Meldung_Ok := TRUE;

    UINT#2:
        "gldb_AktuellerFach_HMI".Meldung.Info_Text := 'Fach ist bereits belegt';
        "gldb_AktuellerFach_HMI".Meldung.Funktion_Meldung_Ok := FALSE;

    UINT#3:
        "gldb_AktuellerFach_HMI".Meldung.Info_Text := 'Fachnummer ungültig';
        "gldb_AktuellerFach_HMI".Meldung.Funktion_Meldung_Ok := FALSE;

    UINT#4:
        "gldb_AktuellerFach_HMI".Meldung.Info_Text := 'Auslagerung erfolgreich';
        "gldb_AktuellerFach_HMI".Meldung.Funktion_Meldung_Ok := TRUE;

    UINT#5:
        "gldb_AktuellerFach_HMI".Meldung.Info_Text := 'Fach ist bereits frei';
        "gldb_AktuellerFach_HMI".Meldung.Funktion_Meldung_Ok := FALSE;

    UINT#6:
        "gldb_AktuellerFach_HMI".Meldung.Info_Text := 'Datensatz gelöscht';
        "gldb_AktuellerFach_HMI".Meldung.Funktion_Meldung_Ok := TRUE;

    UINT#7:
        "gldb_AktuellerFach_HMI".Meldung.Info_Text := 'RFID-Code fehlt';
        "gldb_AktuellerFach_HMI".Meldung.Funktion_Meldung_Ok := FALSE;

    UINT#8:
        "gldb_AktuellerFach_HMI".Meldung.Info_Text := 'Kein passendes Fach gefunden';
        "gldb_AktuellerFach_HMI".Meldung.Funktion_Meldung_Ok := FALSE;

    UINT#9:
        "gldb_AktuellerFach_HMI".Meldung.Info_Text := 'Produkt gefunden';
        "gldb_AktuellerFach_HMI".Meldung.Funktion_Meldung_Ok := TRUE;

    UINT#10:
        "gldb_AktuellerFach_HMI".Meldung.Info_Text := 'Lager voll';
        "gldb_AktuellerFach_HMI".Meldung.Funktion_Meldung_Ok := FALSE;

    UINT#11:
        "gldb_AktuellerFach_HMI".Meldung.Info_Text := 'Factory I/O Zielposition geladen';
        "gldb_AktuellerFach_HMI".Meldung.Funktion_Meldung_Ok := TRUE;

    UINT#12:
        "gldb_AktuellerFach_HMI".Meldung.Info_Text := 'Factory I/O Ziel erreicht';
        "gldb_AktuellerFach_HMI".Meldung.Funktion_Meldung_Ok := TRUE;

    UINT#13:
        "gldb_AktuellerFach_HMI".Meldung.Info_Text := 'Not-Aus aktiv';
        "gldb_AktuellerFach_HMI".Meldung.Funktion_Meldung_Ok := FALSE;

    UINT#14:
        "gldb_AktuellerFach_HMI".Meldung.Info_Text := 'Freies Fach gefunden';
        "gldb_AktuellerFach_HMI".Meldung.Funktion_Meldung_Ok := TRUE;

    UINT#15:
        "gldb_AktuellerFach_HMI".Meldung.Info_Text := 'Fach ist gesperrt';
        "gldb_AktuellerFach_HMI".Meldung.Funktion_Meldung_Ok := FALSE;

    UINT#16:
        "gldb_AktuellerFach_HMI".Meldung.Info_Text := 'Fachposition gespeichert';
        "gldb_AktuellerFach_HMI".Meldung.Funktion_Meldung_Ok := TRUE;

    UINT#17:
        "gldb_AktuellerFach_HMI".Meldung.Info_Text := 'Raster: alle Positionen berechnet';
        "gldb_AktuellerFach_HMI".Meldung.Funktion_Meldung_Ok := TRUE;

    ELSE
        "gldb_AktuellerFach_HMI".Meldung.Info_Text := 'Unbekannte Meldung';
        "gldb_AktuellerFach_HMI".Meldung.Funktion_Meldung_Ok := FALSE;

END_CASE;

"gldb_Meldungen".Status.Meldung := "gldb_AktuellerFach_HMI".Meldung.Info_Text;
