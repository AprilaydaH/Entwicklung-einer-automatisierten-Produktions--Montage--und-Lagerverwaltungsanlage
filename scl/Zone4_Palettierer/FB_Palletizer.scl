//Author: Dereje Hailemariam
//Datum: 02.08.2026
//Version: 2.1
//Beschreibung: Palletizer + HMI (Auto/Manual, Start/Stop/Reset, status lamps, jog)
//============================================================================
// FB_Palletizer
//
// HMI: Start / Stop / Reset / Auto|Manual / SingleCycle
//      Manual jog buttons → actuators only in Manual
//      Lamps: Ready, Running, Done, Stopped, Auto, Manual
//
// 0  INITIALIZE → 10 Load box → 20 Elevator → 30–50 Assembly ×N
// 60 Open plate → 70–72 Unload
//============================================================================

FUNCTION_BLOCK "FB_Palletizer"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 2.1

VAR_INPUT
    // --- HMI commands (WinCC / Comfort Panel) ---
    HMI_Start                   : Bool;  // pulse — start auto cycle
    HMI_Stop                    : Bool;  // level or pulse — abort to idle
    HMI_Reset                   : Bool;  // pulse — clear Done / faults / counters
    HMI_Auto                    : Bool;  // TRUE = Automatic, FALSE = Manual
    HMI_SingleCycle             : Bool;  // TRUE = stop after one unload (no auto-loop)

    // --- HMI manual jog (held buttons, Manual only) ---
    Man_Emit_Stackable_Box      : Bool;
    Man_Roller_Conveyor         : Bool;
    Man_Push                    : Bool;
    Man_Turn                    : Bool;
    Man_Clamp                   : Bool;
    Man_Belt_Fwd                : Bool;
    Man_Belt_Rev                : Bool;
    Man_Chain_Fwd               : Bool;
    Man_Chain_Rev               : Bool;
    Man_Open_Plate              : Bool;
    Man_Elevator_Up             : Bool;
    Man_Elevator_Down           : Bool;
    Man_Move_To_Limit           : Bool;
    Man_Warning_Light           : Bool;

    // --- Stackable box path ---
    Stackable_Box_Present       : Bool;
    Stackable_Box_At_Palletizer : Bool;

    // --- Assembly infeed ---
    Assembled_Part_Present      : Bool;

    // --- Palletizer station sensors ---
    Clamped                     : Bool;
    Plate_Limit                 : Bool;
    Pusher_Limit                : Bool;
    Elevator_Moving             : Bool;
    Elev_Back_Limit             : Bool;
    Elev_Front_Limit            : Bool;

    // --- Recipe (bind to HMI I/O fields) ---
    Belt_Run_Time               : Time := T#1S500MS;
    Plate_Open_Time             : Time := T#1S;
    Unload_Time                 : Time := T#3S;
    Assemblies_Per_Layer        : Int  := 2;
END_VAR

VAR_OUTPUT
    // --- Scene / station ---
    Warning_Light               : Bool;
    Emit_Stackable_Box          : Bool;
    Roller_Conveyor             : Bool;
    Push                        : Bool;
    Turn                        : Bool;
    Clamp                       : Bool;
    Belt_Fwd                    : Bool;
    Belt_Rev                    : Bool;
    Chain_Fwd                   : Bool;
    Chain_Rev                   : Bool;
    Open_Plate                  : Bool;
    Elevator_Up                 : Bool;
    Elevator_Down               : Bool;
    Move_To_Limit               : Bool;

    // --- Process status ---
    Stackable_Box_Ready         : Bool := FALSE;
    Loading_Box_Active          : Bool := FALSE;
    Busy                        : Bool := FALSE;
    Done                        : Bool := FALSE;
    State                       : Int := 0;
    Assembly_Count              : Int := 0;

    // --- HMI feedback ---
    HMI_Lamp_Ready              : Bool;  // idle, auto, can start
    HMI_Lamp_Running            : Bool;  // sequence busy
    HMI_Lamp_Done               : Bool;  // last cycle finished
    HMI_Lamp_Stopped            : Bool;  // stop pressed / held
    HMI_Lamp_Auto               : Bool;
    HMI_Lamp_Manual             : Bool;
    HMI_Cycle_Count             : Int;   // completed unload cycles
    HMI_Step_Text_ID            : Int;   // 0,10,12,20,30,32,40,50,60,70,72 for text list
END_VAR

VAR
    R_Start                     : R_TRIG;
    R_Reset                     : R_TRIG;
    R_PusherLimit               : R_TRIG;
    F_ElevFront                 : F_TRIG;
    F_ElevMoving                : F_TRIG;

    Auto_Run                    : Bool := FALSE;  // latched by HMI_Start
    Step                        : Int := 0;
    Step_Old                    : Int := -1;
    TON_Belt                    : TON;
    TON_Plate                   : TON;
    TON_Unload                  : TON;
    ElevFront_WasTrue           : Bool := FALSE;
    Cycle_Count                 : Int := 0;
END_VAR

VAR_TEMP
    Step_Changed                : Bool;
    Do_Reset_Seq                : Bool;
END_VAR

BEGIN
    #R_Start(CLK := #HMI_Start);
    #R_Reset(CLK := #HMI_Reset);
    #R_PusherLimit(CLK := #Pusher_Limit);
    #F_ElevFront(CLK := #Elev_Front_Limit);
    #F_ElevMoving(CLK := #Elevator_Moving);

    //--------------------------------------------------------------------
    // HMI Reset — clear Done + cycle counter (always allowed)
    //--------------------------------------------------------------------
    IF #R_Reset.Q THEN
        #Done := FALSE;
        #Cycle_Count := 0;
        #HMI_Cycle_Count := 0;
    END_IF;

    //--------------------------------------------------------------------
    // HMI Stop — abort sequence, clear Auto_Run latch
    //--------------------------------------------------------------------
    IF #HMI_Stop THEN
        #Auto_Run := FALSE;
        #Do_Reset_Seq := TRUE;
    ELSE
        #Do_Reset_Seq := FALSE;
    END_IF;

    IF #Do_Reset_Seq THEN
        #Step := 0;
        #Step_Old := -1;
        #Busy := FALSE;
        #Loading_Box_Active := FALSE;
        #Stackable_Box_Ready := FALSE;
        #Assembly_Count := 0;
        #ElevFront_WasTrue := FALSE;

        #Warning_Light := FALSE;
        #Emit_Stackable_Box := FALSE;
        #Roller_Conveyor := FALSE;
        #Push := FALSE;
        #Turn := FALSE;
        #Clamp := FALSE;
        #Belt_Fwd := FALSE;
        #Belt_Rev := FALSE;
        #Chain_Fwd := FALSE;
        #Chain_Rev := FALSE;
        #Open_Plate := FALSE;
        #Elevator_Up := FALSE;
        #Elevator_Down := FALSE;
        #Move_To_Limit := FALSE;

        #TON_Belt(IN := FALSE, PT := #Belt_Run_Time);
        #TON_Plate(IN := FALSE, PT := #Plate_Open_Time);
        #TON_Unload(IN := FALSE, PT := #Unload_Time);
    END_IF;

    //--------------------------------------------------------------------
    // MANUAL MODE — jog only, no auto sequence
    //--------------------------------------------------------------------
    IF NOT #HMI_Auto THEN
        #Auto_Run := FALSE;
        #Busy := FALSE;
        #Step := 0;
        #Step_Old := -1;
        #Loading_Box_Active := FALSE;

        #Emit_Stackable_Box := #Man_Emit_Stackable_Box;
        #Roller_Conveyor    := #Man_Roller_Conveyor;
        #Push               := #Man_Push;
        #Turn               := #Man_Turn;
        #Clamp              := #Man_Clamp;
        #Belt_Fwd           := #Man_Belt_Fwd AND NOT #Man_Belt_Rev;
        #Belt_Rev           := #Man_Belt_Rev AND NOT #Man_Belt_Fwd;
        #Chain_Fwd          := #Man_Chain_Fwd AND NOT #Man_Chain_Rev;
        #Chain_Rev          := #Man_Chain_Rev AND NOT #Man_Chain_Fwd;
        #Open_Plate         := #Man_Open_Plate;
        #Elevator_Up        := #Man_Elevator_Up AND NOT #Man_Elevator_Down;
        #Elevator_Down      := #Man_Elevator_Down AND NOT #Man_Elevator_Up;
        #Move_To_Limit      := #Man_Move_To_Limit;
        #Warning_Light      := #Man_Warning_Light;

        #HMI_Lamp_Ready   := FALSE;
        #HMI_Lamp_Running := FALSE;
        #HMI_Lamp_Done    := #Done;
        #HMI_Lamp_Stopped := #HMI_Stop;
        #HMI_Lamp_Auto    := FALSE;
        #HMI_Lamp_Manual  := TRUE;
        #HMI_Cycle_Count  := #Cycle_Count;
        #HMI_Step_Text_ID := 0;
        #State := 0;
        RETURN;
    END_IF;

    //--------------------------------------------------------------------
    // AUTOMATIC — latch Start (only from idle)
    //--------------------------------------------------------------------
    IF #R_Start.Q AND (#Step = 0) AND NOT #HMI_Stop THEN
        #Auto_Run := TRUE;
        #Done := FALSE;
        #Busy := TRUE;
        #Step := 10;
    END_IF;

    IF #HMI_Stop OR #Do_Reset_Seq THEN
        #HMI_Lamp_Ready   := FALSE;
        #HMI_Lamp_Running := FALSE;
        #HMI_Lamp_Done    := #Done;
        #HMI_Lamp_Stopped := TRUE;
        #HMI_Lamp_Auto    := TRUE;
        #HMI_Lamp_Manual  := FALSE;
        #HMI_Cycle_Count  := #Cycle_Count;
        #HMI_Step_Text_ID := #Step;
        #State := #Step;
        RETURN;
    END_IF;

    // Idle with Auto selected but not started
    IF NOT #Auto_Run AND (#Step = 0) THEN
        #Warning_Light := TRUE;
        #Emit_Stackable_Box := FALSE;
        #Roller_Conveyor := FALSE;
        #Push := FALSE;
        #Turn := FALSE;
        #Clamp := FALSE;
        #Belt_Fwd := FALSE;
        #Belt_Rev := FALSE;
        #Chain_Fwd := FALSE;
        #Chain_Rev := FALSE;
        #Open_Plate := FALSE;
        #Elevator_Up := FALSE;
        #Elevator_Down := FALSE;
        #Move_To_Limit := FALSE;
        #Busy := FALSE;
        #Loading_Box_Active := FALSE;

        #HMI_Lamp_Ready   := TRUE;
        #HMI_Lamp_Running := FALSE;
        #HMI_Lamp_Done    := #Done;
        #HMI_Lamp_Stopped := FALSE;
        #HMI_Lamp_Auto    := TRUE;
        #HMI_Lamp_Manual  := FALSE;
        #HMI_Cycle_Count  := #Cycle_Count;
        #HMI_Step_Text_ID := 0;
        #State := 0;
        RETURN;
    END_IF;

    //--------------------------------------------------------------------
    // AUTO SEQUENCE
    //--------------------------------------------------------------------
    #Step_Changed := (#Step <> #Step_Old);
    IF #Step_Changed THEN
        #Step_Old := #Step;
        #TON_Belt(IN := FALSE, PT := #Belt_Run_Time);
        #TON_Plate(IN := FALSE, PT := #Plate_Open_Time);
        #TON_Unload(IN := FALSE, PT := #Unload_Time);
    END_IF;

    CASE #Step OF

        0: // should not run while Auto_Run — safety idle
            #Busy := FALSE;
            #Auto_Run := FALSE;

        //---------- LOAD STACKABLE BOX ----------
        10:
            #Busy := TRUE;
            #Loading_Box_Active := TRUE;
            #Warning_Light := TRUE;
            #Stackable_Box_Ready := FALSE;
            #Open_Plate := FALSE;
            #Chain_Fwd := FALSE;
            #Chain_Rev := FALSE;
            #Push := FALSE;
            #Clamp := FALSE;
            #Belt_Fwd := FALSE;
            #Belt_Rev := FALSE;
            #Elevator_Up := FALSE;
            #Elevator_Down := FALSE;
            #Move_To_Limit := FALSE;

            #Emit_Stackable_Box := TRUE;

            IF #Stackable_Box_Present THEN
                #Roller_Conveyor := TRUE;
            END_IF;

            IF #Stackable_Box_At_Palletizer THEN
                #Emit_Stackable_Box := FALSE;
                #Roller_Conveyor := FALSE;
                #ElevFront_WasTrue := FALSE;
                #Step := 12;
            END_IF;

        12: // Chain (+) until Elev_Front_Limit TRUE→FALSE
            #Loading_Box_Active := TRUE;
            #Chain_Fwd := TRUE;
            #Chain_Rev := FALSE;

            IF #Elev_Front_Limit THEN
                #ElevFront_WasTrue := TRUE;
            END_IF;

            IF #ElevFront_WasTrue AND #F_ElevFront.Q THEN
                #Chain_Fwd := FALSE;
                #ElevFront_WasTrue := FALSE;
                #Step := 20;
            END_IF;

        20: // Elevator to load height
            #Loading_Box_Active := TRUE;
            #Elevator_Up := TRUE;
            #Elevator_Down := FALSE;
            #Move_To_Limit := TRUE;

            IF #F_ElevMoving.Q THEN
                #Elevator_Up := FALSE;
                #Move_To_Limit := FALSE;
                #Loading_Box_Active := FALSE;
                #Stackable_Box_Ready := TRUE;
                #Assembly_Count := 0;
                #Step := 30;
            END_IF;

        //---------- LOAD ASSEMBLY ×N ----------
        30:
            #Belt_Fwd := FALSE;
            #Push := FALSE;
            #Clamp := FALSE;
            IF #Assembled_Part_Present AND #Stackable_Box_Ready THEN
                #Step := 32;
            END_IF;

        32:
            #Belt_Fwd := TRUE;
            #Belt_Rev := FALSE;
            #TON_Belt(IN := TRUE, PT := #Belt_Run_Time);
            IF #TON_Belt.Q THEN
                #Belt_Fwd := FALSE;
                #Step := 40;
            END_IF;

        40:
            #Push := TRUE;
            IF #R_PusherLimit.Q THEN
                #Push := FALSE;
                #Step := 50;
            END_IF;

        50:
            #Clamp := TRUE;
            IF #Clamped THEN
                #Clamp := FALSE;
                #Assembly_Count := #Assembly_Count + 1;
                IF #Assembly_Count >= #Assemblies_Per_Layer THEN
                    #Step := 60;
                ELSE
                    #Step := 30;
                END_IF;
            END_IF;

        //---------- OPEN PLATE ----------
        60:
            #Open_Plate := TRUE;
            #Clamp := FALSE;
            #Push := FALSE;
            #Belt_Fwd := FALSE;
            #TON_Plate(IN := NOT #Plate_Limit, PT := #Plate_Open_Time);
            IF #TON_Plate.Q THEN
                #Stackable_Box_Ready := FALSE;
                #Step := 70;
            END_IF;

        //---------- UNLOAD ----------
        70:
            #Open_Plate := FALSE;
            #Elevator_Up := FALSE;
            #Elevator_Down := TRUE;
            #Move_To_Limit := TRUE;

            IF #F_ElevMoving.Q THEN
                #Elevator_Down := FALSE;
                #Move_To_Limit := FALSE;
                #Step := 72;
            END_IF;

        72:
            #Chain_Rev := TRUE;
            #Chain_Fwd := FALSE;
            #TON_Unload(IN := TRUE, PT := #Unload_Time);

            IF #TON_Unload.Q OR (NOT #Stackable_Box_At_Palletizer AND NOT #Elev_Front_Limit) THEN
                #Chain_Rev := FALSE;
                #Warning_Light := FALSE;
                #Busy := FALSE;
                #Done := TRUE;
                #Assembly_Count := 0;
                #Cycle_Count := #Cycle_Count + 1;

                IF #HMI_SingleCycle THEN
                    #Auto_Run := FALSE;
                    #Step := 0;
                ELSE
                    #Busy := TRUE;
                    #Done := FALSE;
                    #Warning_Light := TRUE;
                    #Step := 10;
                END_IF;
            END_IF;

        ELSE
            #Step := 0;
            #Auto_Run := FALSE;

    END_CASE;

    //--------------------------------------------------------------------
    // HMI lamps (auto path)
    //--------------------------------------------------------------------
    #HMI_Lamp_Ready   := (#Step = 0) AND NOT #Busy;
    #HMI_Lamp_Running := #Busy OR #Auto_Run;
    #HMI_Lamp_Done    := #Done;
    #HMI_Lamp_Stopped := FALSE;
    #HMI_Lamp_Auto    := TRUE;
    #HMI_Lamp_Manual  := FALSE;
    #HMI_Cycle_Count  := #Cycle_Count;
    #HMI_Step_Text_ID := #Step;
    #State := #Step;

END_FUNCTION_BLOCK
