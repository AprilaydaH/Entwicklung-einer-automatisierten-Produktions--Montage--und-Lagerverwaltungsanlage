//Author: Dereje Hailemariam
//Datum: 02.08.2026
//Version: 1.0
//Beschreibung: Flat UDT — all Palletizer PLC variables
//============================================================================

TYPE "UDT_Palletizer"
VERSION : 1.0
    STRUCT
        // --- HMI commands ---
        HMI_Start                   : Bool := FALSE;
        HMI_Stop                    : Bool := FALSE;
        HMI_Reset                   : Bool := FALSE;
        HMI_Auto                    : Bool := TRUE;
        HMI_SingleCycle             : Bool := FALSE;

        // --- HMI manual jog ---
        Man_Emit_Stackable_Box      : Bool := FALSE;
        Man_Roller_Conveyor         : Bool := FALSE;
        Man_Push                    : Bool := FALSE;
        Man_Turn                    : Bool := FALSE;
        Man_Clamp                   : Bool := FALSE;
        Man_Belt_Fwd                : Bool := FALSE;
        Man_Belt_Rev                : Bool := FALSE;
        Man_Chain_Fwd               : Bool := FALSE;
        Man_Chain_Rev               : Bool := FALSE;
        Man_Open_Plate              : Bool := FALSE;
        Man_Elevator_Up             : Bool := FALSE;
        Man_Elevator_Down           : Bool := FALSE;
        Man_Move_To_Limit           : Bool := FALSE;
        Man_Warning_Light           : Bool := FALSE;

        // --- Sensors ---
        Stackable_Box_Present       : Bool := FALSE;
        Stackable_Box_At_Palletizer : Bool := FALSE;
        Assembled_Part_Present      : Bool := FALSE;
        Clamped                     : Bool := FALSE;
        Plate_Limit                 : Bool := FALSE;
        Pusher_Limit                : Bool := FALSE;
        Elevator_Moving             : Bool := FALSE;
        Elev_Back_Limit             : Bool := FALSE;
        Elev_Front_Limit            : Bool := FALSE;

        // --- Actuators ---
        Warning_Light               : Bool := FALSE;
        Emit_Stackable_Box          : Bool := FALSE;
        Roller_Conveyor             : Bool := FALSE;
        Push                        : Bool := FALSE;
        Turn                        : Bool := FALSE;
        Clamp                       : Bool := FALSE;
        Belt_Fwd                    : Bool := FALSE;
        Belt_Rev                    : Bool := FALSE;
        Chain_Fwd                   : Bool := FALSE;
        Chain_Rev                   : Bool := FALSE;
        Open_Plate                  : Bool := FALSE;
        Elevator_Up                 : Bool := FALSE;
        Elevator_Down               : Bool := FALSE;
        Move_To_Limit               : Bool := FALSE;

        // --- Status ---
        Stackable_Box_Ready         : Bool := FALSE;
        Loading_Box_Active          : Bool := FALSE;
        Busy                        : Bool := FALSE;
        Done                        : Bool := FALSE;
        State                       : Int := 0;
        Assembly_Count              : Int := 0;

        // --- HMI feedback ---
        HMI_Lamp_Ready              : Bool := FALSE;
        HMI_Lamp_Running            : Bool := FALSE;
        HMI_Lamp_Done               : Bool := FALSE;
        HMI_Lamp_Stopped            : Bool := FALSE;
        HMI_Lamp_Auto               : Bool := FALSE;
        HMI_Lamp_Manual             : Bool := FALSE;
        HMI_Cycle_Count             : Int := 0;
        HMI_Step_Text_ID            : Int := 0;

        // --- Recipe ---
        Belt_Run_Time               : Time := T#1S500MS;
        Plate_Open_Time             : Time := T#1S;
        Unload_Time                 : Time := T#3S;
        Assemblies_Per_Layer        : Int := 2;
    END_STRUCT
END_TYPE
