//Author: Dereje Hailemariam
//Datum: 28.07.2026
//Version: 1.3 (working)
//Beschreibung: Two-Axis Pick & Place + Positioning Bars
//              Mit Step-Zeitverzögerung in jedem Schritt (TON_Step)
//              Base Raise 2 s via TP_BaseRaise + TON_BaseRaise
// ============================================================================
// FB_PickPlace — Factory I/O Two-Axis Pick & Place (Digital & Analog)
//
// Two Positioning Bars:
//   Lid  (Left)  — clamps lid at pick,  releases when lid is grabbed
//   Base (Right) — clamps base at place, releases after lid dropped on base
// ============================================================================

FUNCTION_BLOCK "FB_PickPlace"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 1.3

VAR_INPUT
    Automatic_Mode  : Bool;
    Stop            : Bool;
    Reset           : Bool;

    X_Pos_V         : Real;
    Z_Pos_V         : Real;
    Moving_X        : Bool;
    Moving_Z        : Bool;
    Detected        : Bool;

    Lid_Detected    : Bool;
    Base_Detected   : Bool;
    Lid_Clamped     : Bool;
    Base_Clamped    : Bool;

    Step_Delay      : Time := T#300MS;
    Grab_Delay      : Time := T#500MS;
    Drop_Delay      : Time := T#500MS;
    BaseRaise_Time  : Time := T#2S;
END_VAR

VAR_OUTPUT
    X_SetPoint_V    : Real;
    Z_SetPoint_V    : Real;
    Grab            : Bool;
    Rotate_CW       : Bool;
    Rotate_CCW      : Bool;
    Gripper_CW      : Bool;
    Gripper_CCW     : Bool;

    Lid_Clamp       : Bool;
    Lid_Raise       : Bool;
    Base_Clamp      : Bool;
    Base_Raise      : Bool;

    Material_Placed : Bool;
    Busy            : Bool;
    Done            : Bool;
    State           : Int;
END_VAR

VAR
    R_Start         : R_TRIG;
    Step            : Int := 0;
    Step_Old        : Int := -1;
    TON_Step        : TON;
    TON_Grab        : TON;
    TON_Drop        : TON;
    TP_BaseRaise    : TP;
    TON_BaseRaise   : TON;
    Tol_V           : Real := 0.25;
    BaseRaise_Mem   : Bool := FALSE;
    BaseRaise_In    : Bool := FALSE;
END_VAR

VAR_TEMP
    At_XZ           : Bool;
    At_Z            : Bool;
    Step_Changed    : Bool;
END_VAR

BEGIN
    #R_Start(CLK := #Automatic_Mode);

    #Rotate_CW := FALSE;
    #Rotate_CCW := FALSE;
    #Gripper_CW := FALSE;
    #Gripper_CCW := FALSE;

    IF #Reset OR #Stop THEN
        #Step := 0;
        #Step_Old := -1;
        #Busy := FALSE;
        #Done := FALSE;
        #Grab := FALSE;
        #Material_Placed := FALSE;
        #X_SetPoint_V := 0.0;
        #Z_SetPoint_V := 0.0;
        #Lid_Clamp := FALSE;
        #Lid_Raise := FALSE;
        #Base_Clamp := FALSE;
        #Base_Raise := FALSE;
        #BaseRaise_Mem := FALSE;
        #BaseRaise_In := FALSE;
        #TON_Step(IN := FALSE, PT := #Step_Delay);
        #TON_Grab(IN := FALSE, PT := #Grab_Delay);
        #TON_Drop(IN := FALSE, PT := #Drop_Delay);
        #TP_BaseRaise(IN := FALSE, PT := #BaseRaise_Time);
        #TON_BaseRaise(IN := FALSE, PT := T#50MS);
        #State := 0;
        RETURN;
    END_IF;

    // Step-Timer: bei Step-Wechsel neu starten
    #Step_Changed := (#Step <> #Step_Old);
    IF #Step_Changed THEN
        #Step_Old := #Step;
        #TON_Step(IN := FALSE, PT := #Step_Delay);
    END_IF;
    #TON_Step(IN := TRUE, PT := #Step_Delay);

    CASE #Step OF

        0: // Idle
            #Busy := FALSE;
            #Done := FALSE;
            #Grab := FALSE;
            #Material_Placed := FALSE;
            #X_SetPoint_V := 0.0;
            #Z_SetPoint_V := 0.0;
            #Lid_Clamp := FALSE;
            #Lid_Raise := FALSE;
            #Base_Clamp := FALSE;
            #Base_Raise := FALSE;
            #BaseRaise_Mem := FALSE;
            #BaseRaise_In := FALSE;
            IF #R_Start.Q OR #Lid_Detected THEN
                #Busy := TRUE;
                #Step := 5;
            END_IF;

        5: // Lid + Base klemmen
            #Busy := TRUE;
            #Grab := FALSE;
            #X_SetPoint_V := 0.0;
            #Z_SetPoint_V := 0.0;
            IF #Lid_Detected THEN
                #Lid_Clamp := TRUE;
                #Lid_Raise := FALSE;
            END_IF;
            IF #Base_Detected THEN
                #Base_Clamp := TRUE;
                #Base_Raise := FALSE;
            END_IF;
            IF #Lid_Clamped AND #Base_Clamped AND #TON_Step.Q THEN
                #Step := 10;
            END_IF;

        10: // oben X=0 Z=0
            #X_SetPoint_V := 0.0;
            #Z_SetPoint_V := 0.0;
            #At_XZ := (ABS(#X_Pos_V - #X_SetPoint_V) <= #Tol_V) AND (ABS(#Z_Pos_V - #Z_SetPoint_V) <= #Tol_V) AND (NOT #Moving_X) AND (NOT #Moving_Z);
            IF #At_XZ AND #TON_Step.Q THEN
                #Step := 20;
            END_IF;

        20: // Z runter Lid
            #X_SetPoint_V := 0.0;
            #Z_SetPoint_V := 9.4;
            #At_Z := (ABS(#Z_Pos_V - #Z_SetPoint_V) <= #Tol_V) AND (NOT #Moving_Z);
            IF #At_Z AND #TON_Step.Q THEN
                #Step := 30;
            END_IF;

        30: // Greifen
            #Grab := TRUE;
            #X_SetPoint_V := 0.0;
            #Z_SetPoint_V := 9.4;
            #TON_Grab(IN := #Detected, PT := #Grab_Delay);
            IF #TON_Grab.Q AND #TON_Step.Q THEN
                #Lid_Clamp := FALSE;
                #Lid_Raise := FALSE;
                #Step := 40;
            END_IF;

        40: // Hoch Z=0
            #Grab := TRUE;
            #X_SetPoint_V := 0.0;
            #Z_SetPoint_V := 0.0;
            #At_Z := (ABS(#Z_Pos_V - #Z_SetPoint_V) <= #Tol_V) AND (NOT #Moving_Z);
            IF #At_Z AND #TON_Step.Q THEN
                #Step := 50;
            END_IF;

        50: // X zur Base — Clamp schon öffnen (früher)
            #Grab := TRUE;
            #X_SetPoint_V := 10.0;
            #Z_SetPoint_V := 0.0;
            #Base_Clamp := FALSE;
            #At_XZ := (ABS(#X_Pos_V - #X_SetPoint_V) <= #Tol_V) AND (ABS(#Z_Pos_V - #Z_SetPoint_V) <= #Tol_V);
            IF #At_XZ AND #TON_Step.Q THEN
                #Step := 60;
            END_IF;

        60: // Z runter Base — Clamp bleibt offen
            #Grab := TRUE;
            #X_SetPoint_V := 10.0;
            #Z_SetPoint_V := 7.5;
            #Base_Clamp := FALSE;
            #At_Z := (ABS(#Z_Pos_V - #Z_SetPoint_V) <= #Tol_V);
            IF #At_Z AND #TON_Step.Q THEN
                #Step := 70;
            END_IF;

        70: // Kurz prüfen Clamp offen, dann sofort ablegen (ohne Step_Delay)
            #Grab := TRUE;
            #X_SetPoint_V := 10.0;
            #Z_SetPoint_V := 7.5;
            #Base_Clamp := FALSE;
            IF NOT #Base_Clamped THEN
                #Step := 72;
            END_IF;

        72: // Lid auf Base
            #Grab := FALSE;
            #X_SetPoint_V := 10.0;
            #Z_SetPoint_V := 7.5;
            #Material_Placed := TRUE;
            #TON_Drop(IN := NOT #Detected, PT := #Drop_Delay);
            IF #TON_Drop.Q AND #TON_Step.Q THEN
                #Step := 74;
            END_IF;

        74: // Clamp schliessen
            #Base_Clamp := TRUE;
            #X_SetPoint_V := 10.0;
            #Z_SetPoint_V := 7.5;
            IF #Base_Clamped AND #TON_Step.Q THEN
                #Step := 75;
            END_IF;

        75: // Clamp OFF before Raise
            #Grab := FALSE;
            #X_SetPoint_V := 10.0;
            #Z_SetPoint_V := 7.5;
            #Base_Clamp := FALSE;
            #Base_Raise := FALSE;
            IF (NOT #Base_Clamped) AND #TON_Step.Q THEN
                #Step := 76;
            END_IF;

        76: // Raise 2 s via TP/TON
            #Grab := FALSE;
            #X_SetPoint_V := 0.0;
            #Z_SetPoint_V := 0.0;
            #Base_Clamp := FALSE;

            IF NOT #BaseRaise_Mem THEN
                #TP_BaseRaise(IN := FALSE, PT := #BaseRaise_Time);
                #TON_BaseRaise(IN := FALSE, PT := T#50MS);
                #BaseRaise_Mem := TRUE;
                #BaseRaise_In := FALSE;
            ELSE
                #BaseRaise_In := TRUE;
            END_IF;

            #TP_BaseRaise(IN := #BaseRaise_In, PT := #BaseRaise_Time);
            #Base_Raise := #TP_BaseRaise.Q;

            #TON_BaseRaise(IN := #BaseRaise_In AND NOT #TP_BaseRaise.Q, PT := T#50MS);
            IF #TON_BaseRaise.Q THEN
                #Base_Raise := FALSE;
                #BaseRaise_Mem := FALSE;
                #BaseRaise_In := FALSE;
                #Step := 78;
            END_IF;

        78: // Reset + Home
            #Grab := FALSE;
            #Lid_Clamp := FALSE;
            #Lid_Raise := FALSE;
            #Base_Clamp := FALSE;
            #Base_Raise := FALSE;
            #X_SetPoint_V := 0.0;
            #Z_SetPoint_V := 0.0;
            #At_XZ := (ABS(#X_Pos_V - #X_SetPoint_V) <= #Tol_V) AND (ABS(#Z_Pos_V - #Z_SetPoint_V) <= #Tol_V);
            IF #At_XZ AND #TON_Step.Q THEN
                #Busy := FALSE;
                #Done := TRUE;
                #Material_Placed := FALSE;
                #Step := 0;
            END_IF;

        ELSE
            #Step := 0;

    END_CASE;

    #State := #Step;

END_FUNCTION_BLOCK
