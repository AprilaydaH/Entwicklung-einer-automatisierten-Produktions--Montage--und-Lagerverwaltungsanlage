// ============================================================================
// FB_Axis_Analog — Analogachsen-Positionierung (Factory I/O 0…10 V)
// Datei: scl/FB_Axis_Analog.scl
//
// Sollwert als REAL (gleiche Einheit wie Istwert, z.B. mm oder skaliert 0…10).
// Ausgabe: AO_Target (REAL) → Driver → Factory I/O Analog Output.
// In_Position wenn |Ist - Soll| <= Tol und Achse nicht mehr "Moving".
// ============================================================================

FUNCTION_BLOCK "FB_Axis_Analog"
{ S7_Optimized_Access := 'TRUE' }
VERSION : 0.1

VAR_INPUT
    Enable      : Bool;   // Achse freigeben
    Start       : Bool;   // Flanke: neue Zielposition anfahren
    Reset       : Bool;
    Target      : Real;   // Zielposition
    Ist         : Real;   // Istposition (AI skaliert)
    Moving      : Bool;   // Optional: FI Moving-Bit (sonst FALSE)
    Tol         : Real := 0.05; // Positionstoleranz
    Ramp_Limit  : Real := 0.0;  // 0 = direkt Target; sonst max. Delta/Zyklus
END_VAR

VAR_OUTPUT
    Busy        : Bool;
    Done        : Bool;
    Error       : Bool;
    ErrorCode   : UInt;
    AO_Target   : Real;   // Analog-Sollwert an Factory I/O
END_VAR

VAR
    R_Start     : R_TRIG;
    Active      : Bool;
    Cmd_Target  : Real;
END_VAR

VAR_TEMP
    Diff        : Real;
    Step        : Real;
END_VAR

BEGIN
    #R_Start(CLK := #Start);

    IF #Reset THEN
        #Active := FALSE;
        #Busy := FALSE;
        #Done := FALSE;
        #Error := FALSE;
        #ErrorCode := UINT#0;
        #AO_Target := #Ist;
        RETURN;
    END_IF;

    IF NOT #Enable THEN
        #Active := FALSE;
        #Busy := FALSE;
        // Sollwert halten (kein Drift)
        #AO_Target := #Ist;
        RETURN;
    END_IF;

    IF #R_Start.Q THEN
        #Cmd_Target := #Target;
        #Active := TRUE;
        #Done := FALSE;
        #Error := FALSE;
        #ErrorCode := UINT#0;
        #Busy := TRUE;
    END_IF;

    IF #Active THEN
        IF #Ramp_Limit > 0.0 THEN
            #Diff := #Cmd_Target - #AO_Target;
            IF ABS(#Diff) <= #Ramp_Limit THEN
                #AO_Target := #Cmd_Target;
            ELSE
                IF #Diff > 0.0 THEN
                    #Step := #Ramp_Limit;
                ELSE
                    #Step := -#Ramp_Limit;
                END_IF;
                #AO_Target := #AO_Target + #Step;
            END_IF;
        ELSE
            #AO_Target := #Cmd_Target;
        END_IF;

        IF (ABS(#Ist - #Cmd_Target) <= #Tol) AND (NOT #Moving) THEN
            #Active := FALSE;
            #Busy := FALSE;
            #Done := TRUE;
        END_IF;
    ELSE
        #Busy := FALSE;
    END_IF;

END_FUNCTION_BLOCK
