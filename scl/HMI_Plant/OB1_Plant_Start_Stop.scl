    HMI_Start     := "HMI_Plant_Start",
    HMI_Stop      := "HMI_Plant_Stop",
    HMI_Not_Aus   := "HMI_Plant_Not_Aus",
    HMI_Reset     := "HMI_Plant_Reset",

    FIO_Start     := "Production_Start",
    FIO_Stop      := "Production_Stop",
    FIO_Not_Aus   := "Main_Not_Aus",
    FIO_Reset     := "Main_Reset",

    Startup_Init  := "OB100_Startup_Init",

    Plant_Running => "Plant_Running",
    Plant_Not_Aus => "Plant_Not_Aus",
    Plant_Enable  => "Plant_Enable",
    Plant_Ready   => "Plant_Ready",

    FIO_Green     => "Main_Green_Stack_Light",
    FIO_Red       => "Main_Red_Light",
    FIO_StartLamp => "Main_Start_Button_Light",

    Not_Aus       := "Not_Aus",
    Not_Aus_W2    := "Not_Aus_W2"
);
