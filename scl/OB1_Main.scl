// ============================================================================
// Main [OB1] — Pick & Place 2-Axis
// Datei: scl/OB1_Main.scl
//
// In TIA: Main als SCL anlegen, TEMP-Variablen anlegen,
// Instanz-DB "instPickPlace" : FB_PickPlace_2Axis verdrahten.
// Achs_Modus aus gldb_Config (0=Analog, 1=Digital).
// ============================================================================
//
// TEMP:
//   Mode_Auto, Mode_Hand, Mode_Einricht : Bool
// ============================================================================

// =====================================================
// 0) Modi (Priorität: Einricht > Auto > Hand)
// =====================================================
#Mode_Einricht := "Mode_Einricht";
#Mode_Auto := "Mode_Auto" AND NOT #Mode_Einricht;
#Mode_Hand := "Mode_Hand" AND NOT #Mode_Einricht AND NOT #Mode_Auto;

// =====================================================
// 1) Pick & Place Automatik / Hand
//    I/O über gldb_FactoryIO_IO (siehe FACTORY_IO_IO.md)
// =====================================================
"instPickPlace"(
    Auto_Mode := #Mode_Auto,
    Hand_Mode := #Mode_Hand,
    Einricht_Mode := #Mode_Einricht,
    Not_Aus := "gldb_FactoryIO_IO".Input.Not_Aus,

    HMI_Start := "HMI_Start",
    HMI_Stop := "HMI_Stop",
    HMI_Reset := "HMI_Reset",

    HMI_Move_X_Plus := "HMI_Move_X_Plus",
    HMI_Move_X_Minus := "HMI_Move_X_Minus",
    HMI_Move_Z_Plus := "HMI_Move_Z_Plus",
    HMI_Move_Z_Minus := "HMI_Move_Z_Minus",
    HMI_Grab := "HMI_Grab",
    HMI_Release := "HMI_Release",
    HMI_Goto_Home := "HMI_Goto_Home",
    HMI_Goto_Pick := "HMI_Goto_Pick",
    HMI_Goto_Place := "HMI_Goto_Place",
    HMI_Teach_Home := "HMI_Teach_Home",
    HMI_Teach_Pick := "HMI_Teach_Pick",
    HMI_Teach_Place := "HMI_Teach_Place",

    Sensor_Entry := "gldb_FactoryIO_IO".Input.Sensor_Entry,
    Sensor_Exit := "gldb_FactoryIO_IO".Input.Sensor_Exit,
    Item_Detected := "gldb_FactoryIO_IO".Input.Item_Detected,
    Moving_X := "gldb_FactoryIO_IO".Input.Moving_X,
    Moving_Z := "gldb_FactoryIO_IO".Input.Moving_Z,

    Ist_X := "gldb_FactoryIO_IO".Input.Pos_X,
    Ist_Z := "gldb_FactoryIO_IO".Input.Pos_Z,

    X_At_0 := "gldb_FactoryIO_IO".Input.X_At_Home,
    X_At_1 := "gldb_FactoryIO_IO".Input.X_At_Pick,
    X_At_2 := "gldb_FactoryIO_IO".Input.X_At_Place,
    Z_At_0 := "gldb_FactoryIO_IO".Input.Z_At_Up,
    Z_At_1 := "gldb_FactoryIO_IO".Input.Z_At_Down,

    Achs_Modus := "gldb_Config".Achs_Modus,
    Tol_X := "gldb_Config".Tol_X,
    Tol_Z := "gldb_Config".Tol_Z,

    Pos_Home_X := "gldb_Config".Pos.Home_X,
    Pos_Home_Z := "gldb_Config".Pos.Home_Z,
    Pos_Pick_X := "gldb_Config".Pos.Pick_X,
    Pos_Pick_Z := "gldb_Config".Pos.Pick_Z,
    Pos_Pick_Z_Up := "gldb_Config".Pos.Pick_Z_Up,
    Pos_Place_X := "gldb_Config".Pos.Place_X,
    Pos_Place_Z := "gldb_Config".Pos.Place_Z,
    Pos_Place_Z_Up := "gldb_Config".Pos.Place_Z_Up
);

// =====================================================
// 2) Outputs zurückschreiben
// =====================================================
"gldb_FactoryIO_IO".Output.Conv_Entry := "instPickPlace".DO_Conv_Entry;
"gldb_FactoryIO_IO".Output.Conv_Exit := "instPickPlace".DO_Conv_Exit;
"gldb_FactoryIO_IO".Output.Gripper := "instPickPlace".DO_Gripper;

"gldb_FactoryIO_IO".Output.Target_X := "instPickPlace".AO_Target_X;
"gldb_FactoryIO_IO".Output.Target_Z := "instPickPlace".AO_Target_Z;

"gldb_FactoryIO_IO".Output.X_Plus := "instPickPlace".DO_X_Plus;
"gldb_FactoryIO_IO".Output.X_Minus := "instPickPlace".DO_X_Minus;
"gldb_FactoryIO_IO".Output.Z_Plus := "instPickPlace".DO_Z_Plus;
"gldb_FactoryIO_IO".Output.Z_Minus := "instPickPlace".DO_Z_Minus;

// Teach-Punkte zurück in Config (Einricht)
IF #Mode_Einricht THEN
    "gldb_Config".Pos.Home_X := "instPickPlace".Out_Home_X;
    "gldb_Config".Pos.Home_Z := "instPickPlace".Out_Home_Z;
    "gldb_Config".Pos.Pick_X := "instPickPlace".Out_Pick_X;
    "gldb_Config".Pos.Pick_Z := "instPickPlace".Out_Pick_Z;
    "gldb_Config".Pos.Pick_Z_Up := "instPickPlace".Out_Pick_Z_Up;
    "gldb_Config".Pos.Place_X := "instPickPlace".Out_Place_X;
    "gldb_Config".Pos.Place_Z := "instPickPlace".Out_Place_Z;
    "gldb_Config".Pos.Place_Z_Up := "instPickPlace".Out_Place_Z_Up;
END_IF;

// HMI Status
"HMI_Busy" := "instPickPlace".Busy;
"HMI_Done" := "instPickPlace".Done_Cycle;
"HMI_Error" := "instPickPlace".Error;
"HMI_ErrorCode" := "instPickPlace".ErrorCode;
"HMI_State" := "instPickPlace".State;
